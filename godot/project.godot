; Engine configuration file.
; ATLANTEAN BLUEPRINT — Vertical Scrolling Shooter
; Built for Godot 4.x

config_version=5

[application]

config/name="SUNDER: Ascension"
config/description="SUNDER: Ascension — a vertical scrolling shooter. Pilot one of three Atlantean starcraft through nine escalating stages against the Nine Bows. Break them all, avenge Atlantis."
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/sprites/player.svg"

[autoload]

StageData="*res://scripts/StageData.gd"
StoryData="*res://scripts/StoryData.gd"
ShipData="*res://scripts/ShipData.gd"
GameState="*res://scripts/GameState.gd"
AudioManager="*res://scripts/AudioManager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

